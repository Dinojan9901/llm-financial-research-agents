# Copy to .env and fill in. .env is gitignored and must never be committed.

# Primary inference provider: https://console.groq.com/keys
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
# Smaller model for high-volume classification, preserves the daily budget
GROQ_MODEL_FAST=openai/gpt-oss-20b

# Fallback provider, used when Groq rate-limits: https://openrouter.ai/keys
OPENROUTER_API_KEY=
OPENROUTER_MODEL=minimax/minimax-m3:free

# Default ticker for the research pipeline and agents
DEFAULT_TICKER=NVDA

# Optional, risk extractor model upload and agent tracing
HF_TOKEN=
WANDB_API_KEY=
LANGCHAIN_API_KEY=
